<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Catalog Admin - Product Manager</title>
  <style>
    :root { --theme:#111827; --accent:#F59E0B; --bg:#F8FAFC; --card:#FFFFFF; --text:#111827; --muted:#64748B; --line:#E2E8F0; --ok:#047857; --danger:#B91C1C; }
    *{box-sizing:border-box} body{margin:0;font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:var(--text)}
    header{background:linear-gradient(135deg,var(--theme),#020617);color:white;padding:20px 16px 24px;border-bottom:4px solid var(--accent)}
    .wrap{max-width:1200px;margin:0 auto} h1{margin:0;font-size:24px;line-height:1.15}.subtitle{color:#CBD5E1;margin:8px 0 0;font-size:13px;line-height:1.4}
    .toolbar{position:sticky;top:0;z-index:20;background:white;border-bottom:1px solid var(--line);padding:12px 16px;box-shadow:0 8px 20px rgba(15,23,42,.04)}
    .toolbar-grid{display:grid;grid-template-columns:1fr 190px 150px 150px;gap:10px;align-items:center}
    input,select,button,textarea{font:inherit;border:1px solid var(--line);border-radius:12px;padding:10px 11px;background:white} button{cursor:pointer;font-weight:900} button:disabled{opacity:.55;cursor:not-allowed}
    .btn-soft{background:#F1F5F9;color:#334155;border:1px solid var(--line)}.btn-ok{background:#16A34A;color:white;border:none}.btn-danger{background:#FEF2F2;color:var(--danger);border:1px solid #FECACA}
    main{padding:18px 16px 100px}.status{color:var(--muted);font-size:13px;margin:0 0 12px;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}.grid{display:grid;gap:12px}
    .product-card{background:var(--card);border:1px solid var(--line);border-radius:18px;box-shadow:0 8px 22px rgba(15,23,42,.05);overflow:hidden}.product-head{display:grid;grid-template-columns:74px 1fr auto;gap:12px;padding:12px;align-items:center;border-bottom:1px solid var(--line)}
    .thumb{width:74px;height:74px;object-fit:cover;border-radius:14px;background:#E5E7EB;border:1px solid var(--line)}.title{font-weight:950;line-height:1.2}.meta{color:var(--muted);font-size:12px;margin-top:4px;line-height:1.35}
    .status-pill{border-radius:999px;padding:6px 9px;font-size:11px;font-weight:900;background:#ECFDF5;color:var(--ok);white-space:nowrap}.status-pill.inactive{background:#FEF2F2;color:var(--danger)}
    .editor{padding:12px;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.field{display:grid;gap:5px}.field label{font-size:11px;color:var(--muted);font-weight:900;text-transform:uppercase;letter-spacing:.04em}.field-wide{grid-column:span 2}.field-full{grid-column:1/-1}
    .toggles{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:8px;padding-top:2px}.toggle{display:flex;align-items:center;gap:7px;border:1px solid var(--line);background:#F8FAFC;padding:8px 10px;border-radius:999px;font-size:12px;font-weight:900;color:#334155}.toggle input{width:auto;padding:0}
    .actions{grid-column:1/-1;display:flex;justify-content:space-between;gap:10px;align-items:center;border-top:1px solid var(--line);padding-top:10px}.small-note{color:var(--muted);font-size:12px}.toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:#0F172A;color:white;padding:12px 14px;border-radius:14px;box-shadow:0 18px 40px rgba(15,23,42,.28);z-index:100;font-size:13px;display:none;max-width:min(92vw,460px)}.empty{text-align:center;color:var(--muted);padding:40px 16px;border:1px dashed var(--line);border-radius:18px;background:white}
    @media(max-width:850px){.toolbar-grid{grid-template-columns:1fr 1fr}.toolbar-grid input{grid-column:1/-1}.editor{grid-template-columns:1fr 1fr}.field-wide{grid-column:1/-1}}
    @media(max-width:560px){h1{font-size:21px}.toolbar{padding:10px 8px}main{padding:12px 8px 90px}.toolbar-grid{grid-template-columns:1fr;gap:8px}.product-head{grid-template-columns:58px 1fr}.product-head .status-pill{grid-column:1/-1;width:fit-content}.thumb{width:58px;height:58px;border-radius:12px}.editor{grid-template-columns:1fr}.field-wide,.field-full{grid-column:1/-1}.actions{display:grid;grid-template-columns:1fr}.actions button{width:100%}}
  
    .login-panel{padding:28px 16px}.login-card{max-width:440px;margin:0 auto;background:white;border:1px solid var(--line);border-radius:22px;padding:20px;box-shadow:0 16px 38px rgba(15,23,42,.08)}.login-card h2{margin:0 0 6px;font-size:22px}.login-card p{margin:0 0 16px;color:var(--muted);font-size:13px;line-height:1.45}.login-form{display:grid;gap:10px}.login-error{display:none;margin-top:12px;color:var(--danger);background:#FEF2F2;border:1px solid #FECACA;border-radius:12px;padding:10px;font-size:13px}.login-note{margin-top:12px;color:var(--muted);font-size:12px;line-height:1.35}.status-actions{display:flex;gap:8px;flex-wrap:wrap}.btn{border:none;background:var(--theme);color:white}
</style>
</head>
<body>
  <header><div class="wrap"><h1>Catalog Admin</h1><p class="subtitle">Manage product visibility, prices, stock labels, badges, and sorting without editing the Google Sheet directly.</p></div></header>

  <section id="loginPanel" class="wrap login-panel">
    <div class="login-card">
      <h2>Admin Login</h2>
      <p>Enter the admin access key to manage catalog products.</p>
      <form id="loginForm" class="login-form">
        <input id="adminKeyInput" type="password" placeholder="Admin access key" autocomplete="current-password" />
        <button class="btn" type="submit">Unlock Admin</button>
      </form>
      <div id="loginError" class="login-error"></div>
      <div class="login-note">The key is stored only on this device/browser. Use Logout to remove it.</div>
    </div>
  </section>

  <div id="adminApp" style="display:none;">
    <section class="toolbar"><div class="wrap toolbar-grid"><input id="searchInput" type="search" placeholder="Search product, brand, flavor, category..." /><select id="categoryFilter"><option value="">All categories</option></select><select id="activeFilter"><option value="">All products</option><option value="active">Active only</option><option value="inactive">Inactive only</option></select><button class="btn-soft" id="reloadBtn" type="button">Reload</button></div></section>
    <main class="wrap"><div class="status"><div id="statusText">Loading products...</div><div class="status-actions"><button class="btn-soft" id="logoutBtn" type="button">Logout</button><button class="btn-danger" id="clearCacheBtn" type="button">Clear Public Cache</button></div></div><section class="grid" id="productGrid"></section><div class="empty" id="emptyState" style="display:none;">No products found.</div></main>
  </div>

  <div class="toast" id="toast"></div>
<script>
const CATALOG_API_URL='https://script.google.com/macros/s/AKfycbwvM-VSrKnQhVrWdXolLX6EYQOF21uBuS4jqzbcr1mbfS6BtMEtWDS1FbBATdEehqzT/exec';
const ADMIN_KEY_STORAGE='catalogAdminAccessKey_v1';let ADMIN_KEY='';let products=[];let categories=[];let saveInProgress=false;document.addEventListener('DOMContentLoaded',init);
function init(){const p=new URLSearchParams(window.location.search);const keyFromUrl=p.get('key')||'';const savedKey=localStorage.getItem(ADMIN_KEY_STORAGE)||'';ADMIN_KEY=keyFromUrl||savedKey;if(keyFromUrl){localStorage.setItem(ADMIN_KEY_STORAGE,keyFromUrl);try{window.history.replaceState({},document.title,window.location.pathname)}catch(e){}}document.getElementById('loginForm').addEventListener('submit',handleLogin);document.getElementById('searchInput').addEventListener('input',renderProducts);document.getElementById('categoryFilter').addEventListener('change',renderProducts);document.getElementById('activeFilter').addEventListener('change',renderProducts);document.getElementById('reloadBtn').addEventListener('click',loadProducts);document.getElementById('clearCacheBtn').addEventListener('click',clearPublicCache);document.getElementById('logoutBtn').addEventListener('click',logoutAdmin);if(ADMIN_KEY){showAdminApp();loadProducts()}else{showLoginPanel()}}
function handleLogin(event){event.preventDefault();const input=document.getElementById('adminKeyInput');const key=input?input.value.trim():'';if(!key){showLoginError('Please enter the admin access key.');return}ADMIN_KEY=key;localStorage.setItem(ADMIN_KEY_STORAGE,key);showAdminApp();loadProducts()}
function logoutAdmin(){ADMIN_KEY='';localStorage.removeItem(ADMIN_KEY_STORAGE);products=[];categories=[];document.getElementById('productGrid').innerHTML='';document.getElementById('emptyState').style.display='none';document.getElementById('adminKeyInput').value='';showLoginPanel();showToast('Logged out.')}
function showLoginPanel(){document.getElementById('loginPanel').style.display='block';document.getElementById('adminApp').style.display='none'}
function showAdminApp(){hideLoginError();document.getElementById('loginPanel').style.display='none';document.getElementById('adminApp').style.display='block'}
function showLoginError(message){const el=document.getElementById('loginError');if(!el)return;el.textContent=message||'Login failed.';el.style.display='block'}
function hideLoginError(){const el=document.getElementById('loginError');if(!el)return;el.textContent='';el.style.display='none'}
function jsonp(action,params){params=params||{};return new Promise(resolve=>{const cb='adminCallback_'+Date.now()+'_'+Math.floor(Math.random()*100000);const s=document.createElement('script');const sep=CATALOG_API_URL.includes('?')?'&':'?';let done=false;window[cb]=function(r){done=true;try{delete window[cb]}catch(e){}try{s.remove()}catch(e){}resolve(r||{ok:false,error:'Empty response.'})};s.onerror=function(){if(done)return;done=true;try{delete window[cb]}catch(e){}try{s.remove()}catch(e){}resolve({ok:false,error:'Could not connect to Apps Script.'})};setTimeout(function(){if(done)return;done=true;try{delete window[cb]}catch(e){}try{s.remove()}catch(e){}resolve({ok:false,error:'Request timed out.'})},15000);const q=new URLSearchParams();q.set('action',action);q.set('callback',cb);q.set('cacheBust',Date.now());if(ADMIN_KEY)q.set('key',ADMIN_KEY);Object.keys(params).forEach(k=>q.set(k,params[k]));s.src=CATALOG_API_URL+sep+q.toString();document.body.appendChild(s)})}
async function loadProducts(){setStatus('Loading products...');const r=await jsonp('adminProducts');if(!r||!r.ok){const err=r&&r.error?r.error:'Could not load products.';if(String(err).toLowerCase().includes('unauthorized')){localStorage.removeItem(ADMIN_KEY_STORAGE);ADMIN_KEY='';showLoginPanel();showLoginError('Invalid admin key. Please try again.');return}setStatus('Error: '+err);return}products=r.products||[];categories=r.categories||[];populateCategories();renderProducts();showToast('Products loaded.')}
function populateCategories(){const s=document.getElementById('categoryFilter');const cur=s.value;s.innerHTML='<option value="">All categories</option>';categories.forEach(c=>{const o=document.createElement('option');o.value=c;o.textContent=c;s.appendChild(o)});s.value=cur}
function renderProducts(){const grid=document.getElementById('productGrid'),empty=document.getElementById('emptyState');const search=document.getElementById('searchInput').value.trim().toLowerCase();const cat=document.getElementById('categoryFilter').value;const active=document.getElementById('activeFilter').value;const filtered=products.filter(p=>{const hay=[p.category,p.brand,p.productName,p.flavor,p.description,p.stockStatus].join(' ').toLowerCase();if(cat&&p.category!==cat)return false;if(active==='active'&&!p.active)return false;if(active==='inactive'&&p.active)return false;if(search&&!hay.includes(search))return false;return true});setStatus(filtered.length+' product'+(filtered.length===1?'':'s')+' shown · '+products.length+' total');grid.innerHTML='';empty.style.display=filtered.length?'none':'block';filtered.forEach(p=>grid.appendChild(productCard(p)))}
function productCard(p){const card=document.createElement('article');card.className='product-card';card.dataset.rowNumber=p.rowNumber;const title=[p.brand,p.productName].filter(Boolean).join(' ')||'Untitled product';const img=p.imageUrl?'<img class="thumb" src="'+escapeAttr(p.imageUrl)+'" alt="'+escapeAttr(title)+'" onerror="this.outerHTML=\'<div class=&quot;thumb&quot;></div>\'" />':'<div class="thumb"></div>';card.innerHTML='<div class="product-head">'+img+'<div><div class="title">'+escapeHtml(title)+'</div><div class="meta">'+escapeHtml(p.category||'No category')+(p.flavor?' · '+escapeHtml(p.flavor):'')+' · Row '+p.rowNumber+'</div></div><div class="status-pill '+(p.active?'':'inactive')+'">'+(p.active?'Active':'Inactive')+'</div></div><div class="editor">'+fieldHtml('Category','category',p.category,'text')+fieldHtml('Brand','brand',p.brand,'text')+fieldHtml('Product Name','productName',p.productName,'text','field-wide')+fieldHtml('Flavor','flavor',p.flavor,'text')+fieldHtml('Retail Price','retailPrice',p.retailPrice,'number')+fieldHtml('Suggested Price','suggestedRetailPrice',p.suggestedRetailPrice,'number')+fieldHtml('MOQ','moq',p.moq||1,'number')+fieldHtml('Sort Order','sortOrder',p.sortOrder||9999,'number')+selectHtml('Stock Status','stockStatus',p.stockStatus||'Available',['Available','Low Stock','Sold Out','Coming Soon'])+fieldHtml('Image URL','imageUrl',p.imageUrl,'text','field-wide')+textareaHtml('Description','description',p.description,'field-full')+textareaHtml('Notes','notes',p.notes,'field-full')+'<div class="toggles">'+toggleHtml('Active','active',p.active)+toggleHtml('Featured','featured',p.featured)+toggleHtml('New','new',p.new)+toggleHtml('Hot','hot',p.hot)+toggleHtml('Sale','sale',p.sale)+toggleHtml('Limited','limited',p.limited)+'</div><div class="actions"><div class="small-note">Saving clears public catalog cache automatically.</div><button class="btn-ok" type="button" onclick="saveProduct('+p.rowNumber+')">Save Product</button></div></div>';return card}
function fieldHtml(label,key,value,type,extra){return '<div class="field '+(extra||'')+'"><label>'+escapeHtml(label)+'</label><input data-field="'+escapeAttr(key)+'" type="'+escapeAttr(type||'text')+'" value="'+escapeAttr(value==null?'':value)+'" /></div>'}
function textareaHtml(label,key,value,extra){return '<div class="field '+(extra||'')+'"><label>'+escapeHtml(label)+'</label><textarea data-field="'+escapeAttr(key)+'" rows="3">'+escapeHtml(value||'')+'</textarea></div>'}
function selectHtml(label,key,value,opts){return '<div class="field"><label>'+escapeHtml(label)+'</label><select data-field="'+escapeAttr(key)+'">'+opts.map(o=>'<option value="'+escapeAttr(o)+'"'+(o===value?' selected':'')+'>'+escapeHtml(o)+'</option>').join('')+'</select></div>'}
function toggleHtml(label,key,checked){return '<label class="toggle"><input data-field="'+escapeAttr(key)+'" type="checkbox" '+(checked?'checked':'')+' />'+escapeHtml(label)+'</label>'}
async function saveProduct(rowNumber){if(saveInProgress)return;const card=document.querySelector('.product-card[data-row-number="'+rowNumber+'"]');if(!card)return;const existing=products.find(p=>Number(p.rowNumber)===Number(rowNumber));if(!existing)return;const payload=Object.assign({},existing);card.querySelectorAll('[data-field]').forEach(el=>{const key=el.getAttribute('data-field');if(el.type==='checkbox')payload[key]=el.checked;else if(el.type==='number')payload[key]=Number(el.value||0);else payload[key]=el.value});saveInProgress=true;setStatus('Saving product...');const r=await jsonp('adminUpdateProduct',{payload:JSON.stringify(payload)});saveInProgress=false;if(!r||!r.ok){setStatus('Save failed: '+(r&&r.error?r.error:'Unknown error.'));showToast('Save failed.');return}const i=products.findIndex(p=>Number(p.rowNumber)===Number(rowNumber));if(i!==-1)products[i]=payload;renderProducts();showToast('Product saved. Public cache cleared.')}
async function clearPublicCache(){const r=await jsonp('adminClearCatalogCache');if(!r||!r.ok){showToast('Could not clear cache.');return}showToast('Public catalog cache cleared.')}
function setStatus(m){document.getElementById('statusText').textContent=m||''}function showToast(m){const t=document.getElementById('toast');t.textContent=m||'';t.style.display='block';clearTimeout(showToast._timer);showToast._timer=setTimeout(()=>t.style.display='none',2400)}function escapeHtml(v){return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;')}function escapeAttr(v){return escapeHtml(v)}
</script>
</body>
</html>
